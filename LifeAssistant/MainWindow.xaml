<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾光 · 个人生活助手" Width="1000" Height="740" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontFamily="Microsoft YaHei UI" FontSize="14"
        Foreground="#253747" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#425564"/>
      <Setter Property="BorderBrush" Value="#DFE5E9"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#15947D"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#667886"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="FilterSurface" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="FilterSurface" Property="Background" Value="#E1F2EC"/><Setter Property="Foreground" Value="#13765F"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FilterSurface" Property="BorderBrush" Value="#15947D"/><Setter TargetName="FilterSurface" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="TaskTemplate">
      <Border x:Name="TaskCard" Background="White" BorderBrush="#E6EBEE" BorderThickness="1" CornerRadius="12" Padding="18,17" Margin="0,0,0,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock x:Name="TaskTitle" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border x:Name="StateBadge" Background="#FFF1D6" CornerRadius="4" Padding="7,2"><TextBlock x:Name="StateLabel" Text="{Binding StateText}" Foreground="#9C6A16" FontSize="11"/></Border>
              <TextBlock Text="{Binding CreatedAt}" Foreground="#7D8A96" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="{Binding ToggleText}" Tag="toggle" AutomationProperties.Name="{Binding ToggleLabel}" Padding="15,8" Foreground="#13765F" Background="#F0F8F4" BorderBrush="#D9EBE2"/>
            <Button Content="删除" Tag="delete" AutomationProperties.Name="{Binding DeleteLabel}" Padding="12,8" Margin="8,0,0,0" Foreground="#9D5360" BorderBrush="#EFE3E5"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter TargetName="TaskCard" Property="Background" Value="#F8FAF9"/>
          <Setter TargetName="TaskTitle" Property="Foreground" Value="#84928D"/>
          <Setter TargetName="TaskTitle" Property="TextDecorations" Value="Strikethrough"/>
          <Setter TargetName="StateBadge" Property="Background" Value="#E3F1E9"/>
          <Setter TargetName="StateLabel" Property="Foreground" Value="#34775B"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#173E39" Padding="23,30">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Background="#2B574D" CornerRadius="12" Width="46" Height="46" HorizontalAlignment="Left"><TextBlock Text="✓" Foreground="#D5EFCC" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="拾光" Foreground="#F3F6EE" FontSize="28" FontWeight="Bold" Margin="0,14,0,3"/>
          <TextBlock Text="个人生活助手" Foreground="#B2C8BC" FontSize="12"/>
          <Border Background="#2D5B4F" CornerRadius="9" Padding="15,12" Margin="0,42,0,0"><TextBlock Text="☑  我的待办" Foreground="#F1F7EC" FontWeight="SemiBold"/></Border>
          <TextBlock Text="一件一件，慢慢完成。" Foreground="#B2C8BC" FontSize="11" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><TextBlock Text="留一点时间，给生活。" Foreground="#D0DECF" FontSize="12"/><TextBlock Text="本地存储 · 离线可用" Foreground="#9DB8AA" FontSize="11" Margin="0,10,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,28,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Name="DateText" Foreground="#73818E" FontSize="12"/><TextBlock Text="把今天，安排得刚刚好" FontSize="25" FontWeight="Bold" Margin="0,8,0,7"/><TextBlock Text="记下想做的事，从一件小事开始。" Foreground="#74818D" FontSize="12"/></StackPanel>
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,24,0,22">
        <Border Background="White" CornerRadius="11" Padding="17,13" Margin="0,0,10,0"><StackPanel><TextBlock Text="全部任务" Foreground="#7A8793" FontSize="11"/><TextBlock Name="TotalCount" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="#FFF5E4" CornerRadius="11" Padding="17,13" Margin="0,0,10,0"><StackPanel><TextBlock Text="待完成" Foreground="#97723D" FontSize="11"/><TextBlock Name="PendingCount" Text="0" Foreground="#976A29" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="#E8F3EC" CornerRadius="11" Padding="17,13"><StackPanel><TextBlock Text="已完成" Foreground="#52816B" FontSize="11"/><TextBlock Name="DoneCount" Text="0" Foreground="#287052" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      </UniformGrid>
      <StackPanel Grid.Row="2">
        <TextBlock Text="添加一件小事" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="#DCE5E4" BorderThickness="1" CornerRadius="9" Padding="12,0">
            <Grid><TextBox Name="TaskInput" MaxLength="120" FontSize="14" Background="Transparent" BorderThickness="0" Height="46" VerticalContentAlignment="Center" AutomationProperties.Name="任务标题"/>
              <TextBlock Name="InputHint" Text="例如：读 20 页书" Foreground="#9AA5AC" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
          </Border>
          <Button Name="AddButton" Grid.Column="1" Content="＋ 添加任务" Background="#217A61" Foreground="White" BorderBrush="#217A61" Margin="10,0,0,0" Padding="18,10" IsDefault="True"/>
        </Grid>
        <TextBlock Name="Feedback" Text="输入标题后按 Enter，即可添加。最多 120 个字符。" Foreground="#75858D" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <Grid Grid.Row="3" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <RadioButton Name="FilterAll" Content="全部" GroupName="Filter" IsChecked="True" Style="{StaticResource FilterStyle}"/>
          <RadioButton Name="FilterPending" Content="待完成" GroupName="Filter" Style="{StaticResource FilterStyle}"/>
          <RadioButton Name="FilterDone" Content="已完成" GroupName="Filter" Style="{StaticResource FilterStyle}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="未完成优先" Foreground="#8B969E" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><ItemsControl Name="TaskList" ItemTemplate="{StaticResource TaskTemplate}"/></ScrollViewer>
        <StackPanel Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15">
          <Border Background="#E5EFE9" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center"><TextBlock Text="✓" FontSize="29" Foreground="#729A82" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Name="EmptyTitle" Text="从第一件小事开始" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,7"/>
          <TextBlock Name="EmptyHint" Text="在上方写下任务，为生活腾出一点条理。" Foreground="#87948E" FontSize="12"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="5" BorderBrush="#E1E7E6" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0"><TextBlock Name="SaveStatus" Text="●  本地自动保存" Foreground="#537C69" FontSize="11" TextTrimming="CharacterEllipsis"/></Border>
    </Grid>
  </Grid>
</Window>
